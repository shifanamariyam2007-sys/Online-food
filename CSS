* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif; }
body { background: #fff8f0; color: #333; }
.navbar { display: flex; justify-content: space-between; align-items: center;
  background: #e8481c; color: #fff; padding: 14px 30px; position: sticky; top: 0; z-index: 10; }
.navbar nav a { color: #fff; text-decoration: none; margin-left: 20px; font-weight: 600; }
.hero { text-align: center; padding: 50px 20px; color: #fff;
  background: linear-gradient(135deg, #ff7b39, #e8481c); }
.hero p { margin: 8px 0 18px; }
.hero input { width: 90%; max-width: 480px; padding: 12px 16px; border: none;
  border-radius: 30px; font-size: 16px; outline: none; }
main { max-width: 1100px; margin: auto; padding: 20px; }
section { margin-bottom: 40px; }
section h2 { margin-bottom: 14px; color: #e8481c; }
.filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 18px; }
.filter-btn { padding: 8px 18px; border: 2px solid #e8481c; background: #fff;
  color: #e8481c; border-radius: 20px; cursor: pointer; font-weight: 600; }
.filter-btn.active, .filter-btn:hover { background: #e8481c; color: #fff; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px; }
.card { background: #fff; border-radius: 14px; padding: 18px; text-align: center;
  box-shadow: 0 3px 10px rgba(0,0,0,.1); transition: transform .2s; }
.card:hover { transform: translateY(-5px); }
.card .emoji { font-size: 56px; }
.card h3 { margin: 8px 0 4px; }
.card .cat { font-size: 13px; color: #888; }
.card .price { font-weight: bold; color: #e8481c; margin: 8px 0; font-size: 18px; }
button.primary, .card button { background: #e8481c; color: #fff; border: none;
  padding: 10px 20px; border-radius: 8px; cursor: pointer; font-size: 15px; font-weight: 600; }
button.primary:hover, .card button:hover { background: #c93a12; }
.cart-row { display: flex; justify-content: space-between; align-items: center; background: #fff;
  padding: 12px 16px; border-radius: 10px; margin-bottom: 10px; box-shadow: 0 2px 6px rgba(0,0,0,.08); }
.qty button { width: 30px; height: 30px; border: none; border-radius: 50%;
  background: #e8481c; color: #fff; font-size: 18px; cursor: pointer; }
.qty span { margin: 0 10px; font-weight: bold; }
.remove { background: none; border: none; color: #c00; cursor: pointer; margin-left: 12px; font-size: 18px; }
.total { text-align: right; font-size: 22px; font-weight: bold; margin-top: 10px; }
.empty { color: #888; padding: 12px; }
form { background: #fff; padding: 24px; border-radius: 14px; max-width: 520px;
  box-shadow: 0 3px 10px rgba(0,0,0,.1); }
form label { display: block; margin: 12px 0 5px; font-weight: 600; }
form input, form textarea, form select { width: 100%; padding: 10px; border: 1px solid #ccc;
  border-radius: 8px; font-size: 15px; }
form input.invalid, form textarea.invalid { border-color: #c00; }
.error { color: #c00; display: block; min-height: 16px; }
form .primary { margin-top: 16px; width: 100%; }
.modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.55);
  justify-content: center; align-items: center; z-index: 20; }
.modal.show { display: flex; }
.modal-box { background: #fff; padding: 30px; border-radius: 14px; text-align: center; max-width: 400px; }
.modal-box p { margin: 14px 0 20px; }
footer { text-align: center; padding: 18px; background: #333; color: #fff; }
@media (max-width: 600px) {
  .navbar { flex-direction: column; gap: 8px; padding: 12px; }
  .navbar nav a { margin: 0 8px; }
  .hero { padding: 30px 14px; }
  .cart-row { flex-direction: column; gap: 8px; }
}
